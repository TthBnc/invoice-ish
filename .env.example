# Neon pooled connection string. Keep this server-side; do not prefix it with NEXT_PUBLIC_.
# Leave blank for local development to use the persistent PGlite database at
# .data/pglite automatically. Vercel/production requires this variable.
# DATABASE_URL=postgresql://user:password@host/database?sslmode=require
# Direct/unpooled URL for migrations and the one-time backfill. The app keeps
# using DATABASE_URL for normal pooled traffic.
# DATABASE_URL_UNPOOLED=postgresql://user:password@host/database?sslmode=require

# Optional local PGlite data directory. Relative paths are resolved from the
# project root. The default is .data/pglite.
PGLITE_DATA_DIR=.data/pglite

# Shared admin passphrase. The application defaults to the exact value "majonéz"
# when this variable is absent, which is convenient for local development only.
ADMIN_PASSWORD=majonéz

# A long random value used to sign the short-lived HttpOnly admin cookie.
# Set this in Vercel. If absent outside production, the password is used as a
# development fallback so the app can start without extra configuration.
ADMIN_SESSION_SECRET=replace-with-a-long-random-secret
